{
    "name": "lupon",
    "version": "1.0.0",
    "description": "Lupon — Barangay Bula Justice System",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder --win --x64",
        "build:dir": "electron-builder --win --x64 --dir"
    },
    "build": {
        "appId": "com.lupon.bula",
        "productName": "Lupon",
        "copyright": "Barangay Bula",
        "directories": {
            "output": "dist"
        },
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": ["x64"]
                }
            ],
            "icon": "../public/images/bulalogo.ico"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
        },
        "files": [
            "main.js",
            "preload.js",
            "node_modules/**"
        ],
        "extraResources": [
            {
                "from": "../",
                "to": "app",
                "filter": [
                    "**/*",
                    "!electron-app/**",
                    "!node_modules/**",
                    "!.git/**",
                    "!tests/**",
                    "!*.md",
                    "!.env*",
                    "!nativephp/**"
                ]
            },
            {
                "from": "php-bin",
                "to": "php"
            }
        ]
    },
    "dependencies": {
        "tree-kill": "^1.2.2"
    },
    "devDependencies": {
        "electron": "^28.0.0",
        "electron-builder": "^24.0.0"
    }
}
